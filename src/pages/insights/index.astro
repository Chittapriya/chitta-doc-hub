---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, allTags } from '../../lib/posts';

const posts = await getPosts();
const tags = allTags(posts);
---

<Base title="Insights" description="Articles on AI, architecture, networking and developer tooling by Chittapriya Mondal.">
  <section class="container head">
    <p class="eyebrow">Insights</p>
    <h1>Ideas, architecture &amp; lessons learned</h1>
    <p class="lead">{posts.length} articles on AI, architecture, networking and developer tooling.</p>

    <div class="filters" role="toolbar" aria-label="Filter by tag">
      <button type="button" class="chip active" data-filter="all" aria-pressed="true">All</button>
      {tags.map((t) => (
        <button type="button" class="chip" data-filter={t.slug} aria-pressed="false">{t.name}</button>
      ))}
    </div>
  </section>

  <section class="container">
    <div class="post-grid" id="grid">
      {posts.map((post, i) => <PostCard post={post} eager={i < 3} />)}
    </div>
    <p id="empty" hidden>No posts with this tag yet.</p>
  </section>
</Base>

<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const cards = [...document.querySelectorAll<HTMLElement>('#grid .card')];
  const empty = document.getElementById('empty')!;

  function apply(filter: string) {
    let shown = 0;
    for (const card of cards) {
      const match = filter === 'all' || (card.dataset.tags ?? '').split(' ').includes(filter);
      card.hidden = !match;
      if (match) shown++;
    }
    empty.hidden = shown > 0;
    for (const chip of chips) {
      const on = chip.dataset.filter === filter;
      chip.classList.toggle('active', on);
      chip.setAttribute('aria-pressed', String(on));
    }
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter ?? 'all';
      apply(filter);
      history.replaceState(null, '', filter === 'all' ? location.pathname : `#${filter}`);
    });
  }

  const initial = location.hash.slice(1);
  if (initial && chips.some((c) => c.dataset.filter === initial)) apply(initial);
</script>

<style>
  .head { padding-top: 3rem; padding-bottom: 1.5rem; }
  h1 { font-size: clamp(2rem, 4vw, 2.8rem); margin: 0.3rem 0 0.5rem; letter-spacing: -0.02em; }
  .lead { color: var(--text-muted); margin: 0 0 1.6rem; }
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  @media (max-width: 720px) {
    .filters {
      flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none;
      margin: 0 -16px; padding: 0 16px 0.3rem;
      mask-image: linear-gradient(to right, #000 85%, transparent);
    }
    .chip { flex: none; }
  }
  .chip {
    padding: 0.4rem 0.9rem; border-radius: 999px; border: 1px solid var(--border);
    background: var(--surface); color: var(--text-muted); font: inherit; font-size: 0.88rem; cursor: pointer;
  }
  .chip:hover { color: var(--text); border-color: var(--primary); }
  .chip.active { background: var(--primary); border-color: var(--primary); color: #fff; }
  :global(.card[hidden]) { display: none; }
  #empty { color: var(--text-muted); text-align: center; padding: 3rem 0; }
</style>
