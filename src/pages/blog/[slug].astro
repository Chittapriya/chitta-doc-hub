---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingTime, tagSlug, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, date, author, tags, cover, coverFit } = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const coverName = cover.src.split('/').pop()!.split(/[.?]/)[0];
const coverInBody = (post.body ?? '').includes(`${coverName}.`);
---

<Base title={title} description={description}>
  <article>
    <header class="post-head container">
      <a class="back" href="/blog/">← All posts</a>
      <div class="tags">
        {tags.map((t) => <a class="tag" href={`/tags/${tagSlug(t)}/`}>{t}</a>)}
      </div>
      <h1>{title}</h1>
      <p class="desc">{description}</p>
      <div class="meta">
        <span>{author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)} min read</span>
      </div>
    </header>

    {coverInBody ? <div class="spacer" /> : (
      <div class="container">
        <div class:list={['hero-img', coverFit]}>
          <Image src={cover} alt="" width={1400} loading="eager" />
        </div>
      </div>
    )}

    <div class="container layout">
      <div class="prose" id="content">
        <Content />
      </div>

      {toc.length > 2 && (
        <aside class="toc" aria-label="On this page">
          <p class="toc-title">On this page</p>
          <ul>
            {toc.map((h) => (
              <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    <nav class="container pager" aria-label="More posts">
      {newer ? (
        <a href={`/blog/${newer.id}/`} class="newer"><span>← Newer</span>{newer.data.title}</a>
      ) : <span />}
      {older && (
        <a href={`/blog/${older.id}/`} class="older"><span>Older →</span>{older.data.title}</a>
      )}
    </nav>
  </article>
</Base>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const images = [...document.querySelectorAll<HTMLImageElement>('#content img')];

  const lightbox = new PhotoSwipeLightbox({
    pswpModule: () => import('photoswipe'),
    dataSource: [],
    wheelToZoom: true,
    zoom: false,
    bgOpacity: 0.92,
    initialZoomLevel: 'fit',
    secondaryZoomLevel: (z) => z.fit * 2,
    maxZoomLevel: (z) => Math.max(z.fit * 5, 1),
  });

  const zoomBy = (factor: number) => {
    const slide = lightbox.pswp?.currSlide;
    if (!slide) return;
    const { fit, max } = slide.zoomLevels;
    slide.zoomTo(Math.min(Math.max(slide.currZoomLevel * factor, fit), max), undefined, 250);
  };

  lightbox.on('uiRegister', () => {
    const ui = lightbox.pswp!.ui!;
    ui.registerElement({
      name: 'zoom-out',
      title: 'Zoom out (−)',
      order: 8,
      isButton: true,
      html: '<svg viewBox="0 0 32 32" width="32" height="32" class="pswp__icn" aria-hidden="true"><circle cx="14" cy="14" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M11 14h6M19.5 19.5l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
      onClick: () => zoomBy(1 / 1.5),
    });
    ui.registerElement({
      name: 'zoom-in',
      title: 'Zoom in (+)',
      order: 9,
      isButton: true,
      html: '<svg viewBox="0 0 32 32" width="32" height="32" class="pswp__icn" aria-hidden="true"><circle cx="14" cy="14" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M11 14h6M14 11v6M19.5 19.5l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
      onClick: () => zoomBy(1.5),
    });
  });

  lightbox.on('keydown', (e) => {
    const key = e.originalEvent.key;
    if (key === '+' || key === '=') { zoomBy(1.5); e.preventDefault(); }
    if (key === '-' || key === '_') { zoomBy(1 / 1.5); e.preventDefault(); }
  });

  lightbox.init();

  images.forEach((img, index) => {
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', `Open image: ${img.alt || 'figure'}`);
    const open = () => {
      lightbox.options.dataSource = images.map((i) => ({
        src: i.currentSrc || i.src,
        width: i.naturalWidth || i.width,
        height: i.naturalHeight || i.height,
        alt: i.alt,
      }));
      lightbox.loadAndOpen(index);
    };
    img.addEventListener('click', open);
    img.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
    });
  });
</script>

<style>
  .post-head { max-width: 860px; padding-top: 2.5rem; text-align: center; }
  .back { display: inline-block; margin-bottom: 1.4rem; font-weight: 600; text-decoration: none; font-size: 0.92rem; }
  .tags { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.4rem; }
  h1 { font-size: clamp(1.9rem, 4.2vw, 2.9rem); line-height: 1.15; letter-spacing: -0.02em; margin: 1rem 0 0.8rem; }
  .desc { font-size: 1.15rem; color: var(--text-muted); margin: 0 auto 1rem; max-width: 42rem; }
  .meta { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.45rem; color: var(--text-muted); font-size: 0.9rem; }

  .hero-img {
    max-width: 1000px; margin: 2rem auto 2.5rem; aspect-ratio: 2 / 1; overflow: hidden;
    border-radius: var(--radius); border: 1px solid var(--border); background: #fff; box-shadow: var(--shadow);
  }
  .spacer { height: 2rem; border-bottom: 1px solid var(--border); max-width: 760px; margin: 0 auto 1rem; }
  .hero-img img { width: 100%; height: 100%; object-fit: cover; }
  .hero-img.contain img { object-fit: contain; padding: 1rem; }

  .layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 3rem; max-width: 1100px; }
  .prose { max-width: 760px; width: 100%; margin: 0 auto; }
  @media (min-width: 1080px) {
    .layout { grid-template-columns: minmax(0, 1fr) 240px; }
    .prose { margin: 0; }
  }

  .toc { display: none; }
  @media (min-width: 1080px) {
    .toc {
      display: block; position: sticky; top: 5.5rem; align-self: start;
      max-height: calc(100vh - 7rem); overflow-y: auto;
      padding-left: 1rem; border-left: 1px solid var(--border); font-size: 0.86rem;
    }
  }
  .toc-title { font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.75rem; color: var(--text-muted); margin: 0 0 0.6rem; }
  .toc ul { list-style: none; margin: 0; padding: 0; }
  .toc li { margin: 0.35rem 0; }
  .toc li.d3 { padding-left: 0.9rem; }
  .toc a { color: var(--text-muted); text-decoration: none; }
  .toc a:hover { color: var(--primary); }

  .pager {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
    max-width: 1100px; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border);
  }
  .pager a {
    display: flex; flex-direction: column; gap: 0.3rem; padding: 1rem 1.2rem;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface);
    color: var(--text); text-decoration: none; font-weight: 600;
  }
  .pager a:hover { border-color: var(--primary); }
  .pager span { font-size: 0.8rem; font-weight: 500; color: var(--text-muted); }
  .pager .older { text-align: right; grid-column: 2; }
  @media (max-width: 640px) {
    .pager { grid-template-columns: 1fr; }
    .pager .older { grid-column: 1; }
  }
</style>
