<mxfile host="drawio">
  <diagram id="llm-vs-s1" name="LLM vs System One">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="540" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Decision Pipeline: LLM (System 2) vs System One Model" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="llm" value="LLM&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;text in → text out&lt;/span&gt;" style="swimlane;horizontal=0;startSize=110;html=1;rounded=0;fillColor=#FEF2F2;strokeColor=#DC2626;fontStyle=1;fontSize=15;fontColor=#7F1D1D;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="1160" height="210" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="&lt;b&gt;Prompt&lt;/b&gt;&lt;br&gt;instructions + context&lt;br&gt;serialised as text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=11;" vertex="1" parent="llm">
          <mxGeometry x="130" y="40" width="165" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;Sequential decoding&lt;/b&gt;&lt;br&gt;one token at a time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=11;" vertex="1" parent="llm">
          <mxGeometry x="335" y="40" width="165" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="&lt;b&gt;Free-form string&lt;/b&gt;&lt;br&gt;(maybe JSON)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=11;" vertex="1" parent="llm">
          <mxGeometry x="540" y="40" width="165" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="&lt;b&gt;Parse &amp;amp; validate&lt;/b&gt;&lt;br&gt;schema check, guardrails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=11;" vertex="1" parent="llm">
          <mxGeometry x="745" y="40" width="165" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l5" value="&lt;b&gt;Decision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=12;" vertex="1" parent="llm">
          <mxGeometry x="950" y="40" width="165" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lnote" value="≈ 3 – 329 s end-to-end  ·  output tokens ~5× input price  ·  overconfident, can hallucinate / break types" style="text;html=1;fontSize=12;fontStyle=2;align=left;fontColor=#991B1B;" vertex="1" parent="llm">
          <mxGeometry x="130" y="170" width="990" height="25" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="System One&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;state in → types out&lt;/span&gt;" style="swimlane;horizontal=0;startSize=110;html=1;rounded=0;fillColor=#ECFDF5;strokeColor=#059669;fontStyle=1;fontSize=15;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="1160" height="210" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;Structured state&lt;/b&gt;&lt;br&gt;+ typed question schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontSize=11;" vertex="1" parent="s1">
          <mxGeometry x="130" y="45" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;Single parallel pass&lt;/b&gt;&lt;br&gt;all questions at once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontSize=11;" vertex="1" parent="s1">
          <mxGeometry x="400" y="45" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;Typed values&lt;/b&gt;&lt;br&gt;+ calibrated probabilities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=11;" vertex="1" parent="s1">
          <mxGeometry x="670" y="45" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;Decision&lt;/b&gt;&lt;br&gt;branch on confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;fontSize=11;" vertex="1" parent="s1">
          <mxGeometry x="930" y="45" width="185" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rnote" value="≈ 70 – 500 ms  ·  output is free, pay only input ($0.042 / MTok)  ·  no type errors by construction" style="text;html=1;fontSize=12;fontStyle=2;align=left;fontColor=#065F46;" vertex="1" parent="s1">
          <mxGeometry x="130" y="170" width="990" height="25" as="geometry" />
        </mxCell>

        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" value="valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;fontSize=10;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" value="invalid → retry (more latency, more cost)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;dashed=1;fontSize=10;fontColor=#991B1B;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="l4" target="l2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="847" y="210" /><mxPoint x="437" y="210" /></Array></mxGeometry></mxCell>

        <mxCell id="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
