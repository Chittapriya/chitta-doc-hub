---
interface Props {
  size?: number;
}

const { size = 32 } = Astro.props;
---

<svg viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" class="logo">
  <defs>
    <linearGradient id="logo-gradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0284c7" />
      <stop offset="1" stop-color="#22d3ee" />
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="9" fill="url(#logo-gradient)" />
  <path d="M21.66 10.34A8 8 0 1 0 21.66 21.66" fill="none" stroke="#fff" stroke-width="3.6" stroke-linecap="round" />
  <circle cx="16" cy="16" r="2.2" fill="#fff" />
</svg>

<style>
  .logo { display: block; flex: none; }
</style>
