---
import { Image } from 'astro:assets';
import { formatDate, readingTime, tagSlug, type Post } from '../lib/posts';

interface Props {
  post: Post;
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const { title, description, date, tags, cover, coverFit } = post.data;
---

<article class="card" data-tags={tags.map(tagSlug).join(' ')}>
  <div class:list={['cover', coverFit]}>
    <Image src={cover} alt="" width={720} loading={eager ? 'eager' : 'lazy'} />
  </div>
  <div class="body">
    <div class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} min read</span>
    </div>
    <h3><a href={`/insights/${post.id}/`}>{title}</a></h3>
    <p>{description}</p>
    <div class="tags">
      {tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .card:hover, .card:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: color-mix(in srgb, var(--primary) 45%, var(--border));
  }
  .cover { aspect-ratio: 16 / 9; overflow: hidden; background: #fff; border-bottom: 1px solid var(--border); }
  .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .cover.contain img { object-fit: contain; padding: 0.6rem; }
  .card:hover .cover img { transform: scale(1.04); }
  .body { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.1rem 1.25rem 1.3rem; flex: 1; }
  .meta { display: flex; gap: 0.4rem; font-size: 0.8rem; color: var(--text-muted); }
  h3 { margin: 0; font-size: 1.15rem; line-height: 1.35; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  h3 a:focus-visible { outline: none; }
  .card:focus-within { outline: 2px solid var(--primary); outline-offset: 2px; }
  .card:hover h3 a { color: var(--primary); }
  p { margin: 0; color: var(--text-muted); font-size: 0.93rem; line-height: 1.55; flex: 1; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.4rem; }
</style>
